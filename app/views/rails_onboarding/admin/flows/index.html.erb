<% content_for :page_title, "Onboarding Flows" %>

<% content_for :header_actions do %>
  <%= link_to "New Flow", new_admin_flow_path, class: "admin-btn admin-btn-primary" %>
<% end %>

<% if @active_flow %>
  <div class="admin-alert admin-alert-info">
    <strong>Active Flow:</strong> <%= @active_flow[:name] %>
    <span class="admin-badge"><%= @active_flow[:steps]&.length || 0 %> steps</span>
  </div>
<% end %>

<!-- Flows List -->
<div class="admin-flows-grid">
  <% if @flows && @flows.any? %>
    <% @flows.each do |flow| %>
      <div class="admin-flow-card <%= flow[:active] ? 'admin-flow-active' : '' %>">
        <div class="admin-flow-header">
          <h3 class="admin-flow-title">
            <%= flow[:name] %>
            <% if flow[:active] %>
              <span class="admin-badge admin-badge-success">Active</span>
            <% end %>
          </h3>
          <p class="admin-flow-description"><%= flow[:description] %></p>
        </div>

        <div class="admin-flow-body">
          <div class="admin-flow-stats">
            <div class="admin-flow-stat">
              <div class="admin-flow-stat-value"><%= flow[:steps]&.length || 0 %></div>
              <div class="admin-flow-stat-label">Steps</div>
            </div>
            <div class="admin-flow-stat">
              <div class="admin-flow-stat-value">
                <%= flow[:updated_at] ? time_ago_in_words(flow[:updated_at]) : 'N/A' %>
              </div>
              <div class="admin-flow-stat-label">Last Modified</div>
            </div>
          </div>

          <div class="admin-flow-steps-preview">
            <% if flow[:steps] && flow[:steps].any? %>
              <div class="admin-flow-steps-list">
                <% flow[:steps].first(4).each_with_index do |step, index| %>
                  <div class="admin-flow-step-badge">
                    <%= step[:icon] %> <%= step[:title] %>
                  </div>
                <% end %>
                <% if flow[:steps].length > 4 %>
                  <div class="admin-flow-step-more">
                    +<%= flow[:steps].length - 4 %> more
                  </div>
                <% end %>
              </div>
            <% else %>
              <p class="admin-text-muted">No steps configured</p>
            <% end %>
          </div>
        </div>

        <div class="admin-flow-actions">
          <%= link_to "View", admin_flow_path(flow[:id]), class: "admin-btn admin-btn-sm admin-btn-secondary" %>
          <%= link_to "Edit", edit_admin_flow_path(flow[:id]), class: "admin-btn admin-btn-sm admin-btn-secondary" %>
          <%= link_to "Preview", preview_admin_flow_path(flow[:id]), class: "admin-btn admin-btn-sm admin-btn-secondary", target: "_blank" %>

          <% unless flow[:active] %>
            <%= button_to "Activate",
                activate_admin_flow_path(flow[:id]),
                method: :post,
                class: "admin-btn admin-btn-sm admin-btn-success",
                data: { confirm: "Activate this flow? This will deactivate the current flow." } %>
          <% end %>

          <%= button_to "Duplicate",
              duplicate_admin_flow_path(flow[:id]),
              method: :post,
              class: "admin-btn admin-btn-sm admin-btn-secondary" %>

          <% unless flow[:active] %>
            <%= button_to "Delete",
                admin_flow_path(flow[:id]),
                method: :delete,
                class: "admin-btn admin-btn-sm admin-btn-danger",
                data: { confirm: "Are you sure you want to delete this flow?" } %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="admin-empty-state-large">
      <div class="admin-empty-icon">📋</div>
      <h3>No Flows Created</h3>
      <p>Create your first onboarding flow to get started.</p>
      <%= link_to "Create Flow", new_admin_flow_path, class: "admin-btn admin-btn-primary" %>
    </div>
  <% end %>
</div>

<!-- Templates Section -->
<% if @templates && @templates.any? %>
  <div class="admin-section">
    <h2 class="admin-section-title">Pre-built Templates</h2>
    <p class="admin-section-description">Start with a template designed for your use case</p>

    <div class="admin-templates-grid">
      <% @templates.each do |template| %>
        <div class="admin-template-card">
          <h4 class="admin-template-title"><%= template[:name] %></h4>
          <p class="admin-template-description"><%= template[:description] %></p>
          <%= link_to "Use Template", new_admin_flow_path(template: template[:id]), class: "admin-btn admin-btn-sm admin-btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
