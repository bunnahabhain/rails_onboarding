<div class="admin-ab-test-card">
  <div class="admin-ab-test-header">
    <h3 class="admin-ab-test-title"><%= test[:name] %></h3>
    <span class="admin-badge admin-badge-<%= test[:enabled] ? 'active' : 'draft' %>">
      <%= test[:enabled] ? 'Active' : 'Inactive' %>
    </span>
  </div>

  <div class="admin-ab-test-meta">
    <div class="admin-ab-test-meta-item">
      <strong>Variants:</strong> <%= test[:variants].join(', ') %>
    </div>
  </div>

  <div class="admin-ab-test-actions">
    <%= link_to "View Results", admin_ab_test_path(test[:name]), class: "admin-btn admin-btn-sm admin-btn-secondary" %>

    <% if test[:enabled] %>
      <%= button_to "Stop", stop_admin_ab_test_path(test[:name]), method: :post, class: "admin-btn admin-btn-sm admin-btn-warning" %>
    <% else %>
      <%= button_to "Start", start_admin_ab_test_path(test[:name]), method: :post, class: "admin-btn admin-btn-sm admin-btn-success" %>
    <% end %>
  </div>
</div>
