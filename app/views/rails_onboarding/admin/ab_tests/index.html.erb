<% content_for :page_title, "A/B Tests" %>

<!-- Stats -->
<div class="admin-stats-grid admin-stats-compact">
  <div class="admin-stat-card">
    <div class="admin-stat-label">Active Tests</div>
    <div class="admin-stat-value"><%= @active_tests.count %></div>
  </div>
  <div class="admin-stat-card">
    <div class="admin-stat-label">Inactive Tests</div>
    <div class="admin-stat-value"><%= @inactive_tests.count %></div>
  </div>
  <div class="admin-stat-card">
    <div class="admin-stat-label">Total Tests</div>
    <div class="admin-stat-value"><%= @ab_tests.count %></div>
  </div>
</div>

<!-- Active Tests -->
<% if @active_tests.any? %>
  <div class="admin-section">
    <h2 class="admin-section-title">Active Tests</h2>
    <div class="admin-ab-tests-grid">
      <% @active_tests.each do |test| %>
        <%= render 'ab_test_card', test: test %>
      <% end %>
    </div>
  </div>
<% end %>

<!-- Inactive Tests -->
<% if @inactive_tests.any? %>
  <div class="admin-section">
    <h2 class="admin-section-title">Inactive Tests</h2>
    <div class="admin-ab-tests-grid">
      <% @inactive_tests.each do |test| %>
        <%= render 'ab_test_card', test: test %>
      <% end %>
    </div>
  </div>
<% end %>

<% if @ab_tests.empty? %>
  <div class="admin-empty-state-large">
    <div class="admin-empty-icon">🧪</div>
    <h3>No A/B Tests Configured</h3>
    <p>Define A/B tests in your <code>config/initializers/rails_onboarding.rb</code> via <code>config.ab_tests</code> to manage them here.</p>
  </div>
<% end %>
