<!DOCTYPE html>
<html>
<head>
  <title>Welcome - Getting Started</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "rails_onboarding/application", media: "all" %>
</head>
<body>
<main class="onboarding-container">
  <header class="onboarding-header">
    <%= render 'progress_indicator' %>
    <div class="step-navigation">
      <span class="step-counter">Step <%= @progress %> of <%= @total_steps %></span>
    </div>
  </header>

  <section class="onboarding-content">
    <div class="step-content">
      <div class="step-icon">
        <%= @current_step[:icon] if @current_step %>
      </div>

      <h1 class="step-title">
        <%= @current_step[:title] if @current_step %>
      </h1>

      <div class="step-body">
        <%= render @current_step[:name] if @current_step %>
      </div>
    </div>
  </section>

  <footer class="onboarding-footer">
    <%= render 'step_navigation' %>
  </footer>
</main>
</body>
</html>
