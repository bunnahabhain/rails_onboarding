<!DOCTYPE html>
<html>
<head>
  <title>Welcome - Getting Started</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "rails_onboarding/application", media: "all" %>
</head>
<body>
<main class="onboarding-container">
  <header class="onboarding-header">
    <%= render 'progress_indicator' %>
  </header>

  <section class="onboarding-content">
    <div class="step-content" data-controller="onboarding" data-onboarding-current-step-value="<%= @current_step[:name] if @current_step %>">
      <% if @current_step %>
        <div class="step-icon">
          <%= @current_step[:icon] %>
        </div>

        <h1 class="step-title">
          <%= @current_step[:title] %>
        </h1>

        <div class="step-body">
          <!-- Render the step-specific template -->
          <% if @current_step[:name] %>
            <%= render @current_step[:name].to_s %>
          <% else %>
            <%= render 'step' %>
          <% end %>
        </div>
      <% else %>
        <div class="step-error">
          <h1>Configuration Error</h1>
          <p>No onboarding step is configured. Please check your onboarding setup.</p>
        </div>
      <% end %>
    </div>
  </section>

  <footer class="onboarding-footer">
    <%= render 'step_navigation' %>
  </footer>
</main>

<%= javascript_include_tag "rails_onboarding/application", defer: true %>
</body>
</html>
