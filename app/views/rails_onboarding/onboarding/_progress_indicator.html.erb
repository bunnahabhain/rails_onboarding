<div class="progress-indicator" data-controller="progress" data-progress-value="<%= @progress %>">
  <div class="onboarding-progress-bar">
    <div class="onboarding-progress-fill" style="--onboarding-progress-width: <%= @progress %>%"></div>
  </div>

  <div class="progress-steps">
    <%
      # Calculate current step index (1-based)
      current_step_index = @current_step ? RailsOnboarding.configuration.step_index(@current_step[:name]) + 1 : 1
    %>

    <% RailsOnboarding.configuration.steps.each_with_index do |step, index| %>
      <% step_number = index + 1 %>
      <%
        step_class = "progress-step"
        step_class += " onboarding-completed" if step_number < current_step_index
        step_class += " onboarding-current" if step_number == current_step_index
        step_class += " onboarding-upcoming" if step_number > current_step_index
      %>

      <div class="<%= step_class %>" data-step="<%= step_number %>">
        <div class="step-marker">
          <% if step_number < current_step_index %>
            <span class="step-check">✓</span>
          <% elsif step_number == current_step_index %>
            <span class="step-number"><%= step_number %></span>
          <% else %>
            <span class="step-number"><%= step_number %></span>
          <% end %>
        </div>

        <div class="step-label">
          <span class="step-title"><%= step[:title] %></span>
        </div>
      </div>
    <% end %>
  </div>

  <div class="onboarding-progress-text">
    <span class="current-progress">Step <%= current_step_index %></span>
    <span class="total-steps">of <%= @total_steps %></span>
    
    <% if RailsOnboarding.configuration.enable_milestones && defined?(current_user) && current_user %>
      <div class="milestone-progress">
        <span class="milestone-points">🏆 <%= current_user.total_milestone_points %> points</span>
        <% if current_user.recent_milestones(limit: 1).any? %>
          <span class="recent-milestone">
            Latest: <%= current_user.recent_milestones(limit: 1).first[:icon] %> <%= current_user.recent_milestones(limit: 1).first[:title] %>
          </span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
