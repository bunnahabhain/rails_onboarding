<div id="onboarding-content">
  <div class="onboarding-step-wrapper">
    <%= render partial: "rails_onboarding/onboarding/progress_indicator",
               locals: { progress: progress, total_steps: total_steps } %>

    <div class="step-content">
      <% if current_step %>
        <div class="step-header">
          <% if current_step[:icon] %>
            <span class="step-icon"><%= current_step[:icon] %></span>
          <% end %>
          <h2 class="step-title"><%= current_step[:title] %></h2>
        </div>

        <div class="step-body">
          <% if current_step[:description] %>
            <p class="step-description"><%= current_step[:description] %></p>
          <% end %>

          <%= yield if block_given? %>
        </div>

        <%= render partial: "rails_onboarding/onboarding/step_navigation",
                   locals: { current_step: current_step } %>
      <% else %>
        <p>No current step available.</p>
      <% end %>
    </div>
  </div>
</div>
