<article class="explore-step">
  <div class="step-description">
    <p class="step-intro">
      Excellent! You're almost done. Let's quickly explore the key features
      that will help you get the most out of the app.
    </p>
  </div>

  <div class="feature-showcase">
    <div class="feature-grid">
      <div class="feature-card" data-feature="organizing">
        <div class="feature-header">
          <span class="feature-icon">📋</span>
          <h3 class="feature-title">Smart Organization</h3>
        </div>
        <p class="feature-description">
          Create nested lists, set priorities, and keep everything organized exactly how you like it.
        </p>
        <button type="button" class="feature-button" data-action="click->onboarding#showFeatureTooltip" data-feature-target="organizing">
          Learn More
        </button>
      </div>

      <div class="feature-card" data-feature="collaboration">
        <div class="feature-header">
          <span class="feature-icon">🤝</span>
          <h3 class="feature-title">Team Collaboration</h3>
        </div>
        <p class="feature-description">
          Share lists with family, friends, or colleagues and work together in real-time.
        </p>
        <button type="button" class="feature-button" data-action="click->onboarding#showFeatureTooltip" data-feature-target="collaboration">
          Learn More
        </button>
      </div>

      <div class="feature-card" data-feature="automation">
        <div class="feature-header">
          <span class="feature-icon">⚡</span>
          <h3 class="feature-title">Smart Automation</h3>
        </div>
        <p class="feature-description">
          Set up recurring tasks, reminders, and automatic list generation to save time.
        </p>
        <button type="button" class="feature-button" data-action="click->onboarding#showFeatureTooltip" data-feature-target="automation">
          Learn More
        </button>
      </div>

      <div class="feature-card" data-feature="insights">
        <div class="feature-header">
          <span class="feature-icon">📊</span>
          <h3 class="feature-title">Progress Insights</h3>
        </div>
        <p class="feature-description">
          Track your productivity and see patterns in how you complete tasks.
        </p>
        <button type="button" class="feature-button" data-action="click->onboarding#showFeatureTooltip" data-feature-target="insights">
          Learn More
        </button>
      </div>
    </div>
  </div>

  <div class="next-steps">
    <h2>Ready to get started?</h2>
    <p class="next-steps-description">
      You're all set! You can always revisit these features from the help menu.
    </p>

    <div class="action-buttons">
      <%= form_with url: rails_onboarding.complete_onboarding_path, method: :post, local: true, class: "onboarding-form" do |form| %>
        <%= form.submit "Complete Onboarding 🎉", class: "primary-action" %>
      <% end %>

      <% if @current_step[:skippable] %>
        <%= form_with url: rails_onboarding.skip_onboarding_path, method: :post, local: true, class: "onboarding-form" do |form| %>
          <%= form.submit "Skip to Dashboard", class: "secondary-action",
                          data: {
                            confirm: "Are you sure you want to skip to the dashboard?",
                            turbo: false
                          } %>
        <% end %>
      <% end %>
    </div>
  </div>
</article>
