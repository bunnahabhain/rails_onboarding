<%= turbo_stream.replace "onboarding-content" do %>
  <%= render partial: "rails_onboarding/onboarding/step_content",
             locals: { current_step: @current_step, progress: @progress, total_steps: @total_steps } %>
<% end %>

<% if params[:awarded_milestones].present? %>
  <%= turbo_stream.prepend "flash-messages" do %>
    <div class="onboarding-flash flash-success milestone-celebration" role="alert">
      <span class="flash-icon">🎉</span>
      <span class="flash-message">
        Milestones achieved: <%= params[:awarded_milestones].join(", ") %>
      </span>
      <button class="flash-close" onclick="this.parentElement.remove()" aria-label="Dismiss">×</button>
    </div>
  <% end %>
<% end %>

<%= turbo_stream.replace "progress-indicator" do %>
  <%= render partial: "rails_onboarding/onboarding/progress_indicator",
             locals: { progress: @progress, total_steps: @total_steps } %>
<% end %>
