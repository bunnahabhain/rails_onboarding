<article class="first-action-step">
  <div class="step-description">
    <p class="step-intro">
      Great! Now let's take your first action. This will help you get familiar
      with the main features you'll be using.
    </p>
  </div>

  <div class="action-options">
    <h2>Choose your first action:</h2>

    <%= form_with url: rails_onboarding.next_onboarding_path, method: :post, local: true, class: "onboarding-form" do |form| %>
      <fieldset class="action-choices">
        <legend>Select an action to get started</legend>

        <div class="action-choice-grid">
          <label class="action-choice" for="first_action_create_todo">
            <%= radio_button_tag "step_data[first_action]", "create_todo", false, id: "first_action_create_todo" %>
            <div class="choice-content">
              <span class="choice-icon">📝</span>
              <h3 class="choice-title">Create Your First Todo</h3>
              <p class="choice-description">Start by creating a simple task to get familiar with the basics.</p>
            </div>
          </label>

          <label class="action-choice" for="first_action_explore_lists">
            <%= radio_button_tag "step_data[first_action]", "explore_lists", false, id: "first_action_explore_lists" %>
            <div class="choice-content">
              <span class="choice-icon">📋</span>
              <h3 class="choice-title">Explore List Types</h3>
              <p class="choice-description">Discover different ways to organize your tasks and projects.</p>
            </div>
          </label>

          <label class="action-choice" for="first_action_invite_team">
            <%= radio_button_tag "step_data[first_action]", "invite_team", false, id: "first_action_invite_team" %>
            <div class="choice-content">
              <span class="choice-icon">👥</span>
              <h3 class="choice-title">Invite Team Members</h3>
              <p class="choice-description">Start collaborating by inviting colleagues or friends.</p>
            </div>
          </label>

          <label class="action-choice" for="first_action_customize">
            <%= radio_button_tag "step_data[first_action]", "customize", false, id: "first_action_customize" %>
            <div class="choice-content">
              <span class="choice-icon">🎨</span>
              <h3 class="choice-title">Customize Your Workspace</h3>
              <p class="choice-description">Personalize the interface to match your workflow.</p>
            </div>
          </label>
        </div>
      </fieldset>

      <div class="action-buttons">
        <%= form.submit "Continue", class: "primary-action" %>
      </div>
    <% end %>
  </div>

  <div class="helpful-tip">
    <h3>💡 Helpful Tip</h3>
    <p>Don't worry about making the perfect choice - you can always explore other features later!</p>
  </div>
</article>
