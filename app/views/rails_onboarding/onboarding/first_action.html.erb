<article class="first-action-step">
  <div class="step-description">
    <p class="step-intro">
      Great! Now let's take your first action. This will help you get familiar
      with the main features you'll be using.
    </p>
  </div>

  <div class="action-options">
    <h2>Choose your first action:</h2>

    <%= form_with url: rails_onboarding.next_onboarding_path, method: :post, local: true, class: "onboarding-form" do |form| %>
      <fieldset class="profile-settings">
        <legend>Profile Settings</legend>

        <div class="form-group">
          <%= label_tag "step_data[timezone]", "Time Zone" %>
          <%= select_tag "step_data[timezone]",
                         options_for_select([
                                              ["Eastern Time", "America/New_York"],
                                              ["Central Time", "America/Chicago"],
                                              ["Mountain Time", "America/Denver"],
                                              ["Pacific Time", "America/Los_Angeles"],
                                              ["UTC", "UTC"]
                                            ], current_user.try(:time_zone) || "UTC"),
                         { class: "timezone-select" } %>
          <span class="help-text">This helps us show you times in your local timezone</span>
        </div>

        <div class="form-group">
          <%= label_tag "step_data[notifications_enabled]" do %>
            <%= check_box_tag "step_data[notifications_enabled]", "1", true %>
            <span class="checkbox-label">Enable notifications</span>
          <% end %>
          <span class="help-text">Get updates about important activities (you can change this later)</span>
        </div>

        <div class="form-group">
          <%= label_tag "step_data[experience_level]", "Experience Level" %>
          <%= select_tag "step_data[experience_level]",
                         options_for_select([
                                              ["I'm new to this", "beginner"],
                                              ["I have some experience", "intermediate"],
                                              ["I'm experienced", "advanced"]
                                            ]),
                         { class: "experience-select" } %>
          <span class="help-text">This helps us show you the right level of detail</span>
        </div>
      </fieldset>

      <div class="action-buttons">
        <%= form.submit "Continue", class: "primary-action" %>
      </div>
    <% end %>
  </div>

  <div class="helpful-tip">
    <h3>💡 Helpful Tip</h3>
    <p>Don't worry about making the perfect choice - you can always explore other features later!</p>
  </div>
</article>
