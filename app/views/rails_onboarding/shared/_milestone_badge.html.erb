<%# 
  Milestone badge partial for showing milestone achievements
  Usage: <%= render 'rails_onboarding/shared/milestone_badge', milestone: milestone_config, achieved: true/false %>
%>

<div class="milestone-badge <%= 'achieved' if achieved %> <%= 'locked' unless achieved %>">
  <div class="badge-icon">
    <%= milestone[:icon] %>
    <% unless achieved %>
      <div class="lock-overlay">🔒</div>
    <% end %>
  </div>
  
  <div class="badge-content">
    <div class="badge-title"><%= milestone[:title] %></div>
    <div class="badge-points">+<%= milestone[:points] %></div>
  </div>
  
  <% if achieved %>
    <div class="achievement-check">✅</div>
  <% end %>
</div>