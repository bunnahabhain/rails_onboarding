<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }
      .header {
        text-align: center;
        padding: 20px 0;
        border-bottom: 2px solid #f0f0f0;
      }
      .content {
        padding: 30px 0;
      }
      .progress-bar {
        background-color: #f0f0f0;
        border-radius: 10px;
        height: 20px;
        margin: 20px 0;
        overflow: hidden;
      }
      .progress-fill {
        background-color: #10B981;
        height: 100%;
        transition: width 0.3s ease;
      }
      .cta-button {
        display: inline-block;
        padding: 12px 24px;
        background-color: #4F46E5;
        color: white;
        text-decoration: none;
        border-radius: 6px;
        margin: 20px 0;
      }
      .footer {
        text-align: center;
        padding: 20px 0;
        border-top: 2px solid #f0f0f0;
        color: #666;
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <div class="header">
      <h1>🚀 <%= t('rails_onboarding.mailer.reminder.heading', default: 'Complete Your Onboarding') %></h1>
    </div>

    <div class="content">
      <p><%= t('rails_onboarding.mailer.reminder.greeting', default: 'Hi there!', name: @user.respond_to?(:name) ? @user.name : 'there') %></p>

      <p>
        <%= t('rails_onboarding.mailer.reminder.intro',
          default: "We noticed you started your onboarding journey but haven't finished it yet. You're doing great so far!") %>
      </p>

      <p>
        <strong><%= t('rails_onboarding.mailer.reminder.progress',
          default: 'Your Progress',
          progress: @progress) %>:</strong> <%= @progress %>%
      </p>

      <div class="progress-bar">
        <div class="progress-fill" style="width: <%= @progress %>%;"></div>
      </div>

      <% if @current_step %>
        <p>
          <%= t('rails_onboarding.mailer.reminder.current_step',
            default: 'You left off at',
            step: @current_step.to_s.titleize) %>: <strong><%= @current_step.to_s.titleize %></strong>
        </p>
      <% end %>

      <p>
        <%= t('rails_onboarding.mailer.reminder.encouragement',
          default: "You're almost there! Complete your onboarding to unlock all features and get the most out of your experience.") %>
      </p>

      <div style="text-align: center;">
        <a href="<%= @onboarding_url %>" class="cta-button">
          <%= t('rails_onboarding.mailer.reminder.cta', default: 'Continue Onboarding') %>
        </a>
      </div>
    </div>

    <div class="footer">
      <p><%= t('rails_onboarding.mailer.reminder.footer', default: 'See you soon!') %></p>
    </div>
  </body>
</html>
