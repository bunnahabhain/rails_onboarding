<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }
      .header {
        text-align: center;
        padding: 20px 0;
        border-bottom: 2px solid #f0f0f0;
      }
      .content {
        padding: 30px 0;
      }
      .progress-bar {
        background-color: #f0f0f0;
        border-radius: 10px;
        height: 20px;
        margin: 20px 0;
        overflow: hidden;
      }
      .progress-fill {
        background-color: #10B981;
        height: 100%;
        transition: width 0.3s ease;
      }
      .step-badge {
        background-color: #EEF2FF;
        color: #4F46E5;
        padding: 10px 20px;
        border-radius: 6px;
        display: inline-block;
        margin: 10px 0;
        font-weight: 600;
      }
      .cta-button {
        display: inline-block;
        padding: 12px 24px;
        background-color: #4F46E5;
        color: white;
        text-decoration: none;
        border-radius: 6px;
        margin: 20px 0;
      }
      .footer {
        text-align: center;
        padding: 20px 0;
        border-top: 2px solid #f0f0f0;
        color: #666;
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <div class="header">
      <h1>✅ <%= t('rails_onboarding.mailer.step_completed.heading', default: 'Step Completed!') %></h1>
    </div>

    <div class="content">
      <p><%= t('rails_onboarding.mailer.step_completed.greeting', default: 'Hi there!', name: @user.respond_to?(:name) ? @user.name : 'there') %></p>

      <p>
        <%= t('rails_onboarding.mailer.step_completed.intro', default: 'Great job completing another step in your onboarding journey!') %>
      </p>

      <% if @step %>
        <div style="text-align: center;">
          <span class="step-badge">
            <%= @step.to_s.titleize %>
          </span>
        </div>
      <% end %>

      <p>
        <strong><%= t('rails_onboarding.mailer.step_completed.progress', default: 'Your Progress') %>:</strong> <%= @progress %>%
      </p>

      <div class="onboarding-progress-bar">
        <div class="onboarding-progress-fill" style="width: <%= @progress %>%;"></div>
      </div>

      <p>
        <%= t('rails_onboarding.mailer.step_completed.encouragement',
          default: "Keep up the great work! Each step brings you closer to unlocking all features and getting the most out of your experience.") %>
      </p>

      <div style="text-align: center;">
        <a href="<%= Rails.application.routes.url_helpers.rails_onboarding_onboarding_url rescue '#' %>" class="cta-button">
          <%= t('rails_onboarding.mailer.step_completed.cta', default: 'Continue Onboarding') %>
        </a>
      </div>
    </div>

    <div class="footer">
      <p><%= t('rails_onboarding.mailer.step_completed.footer', default: 'Keep going!') %></p>
    </div>
  </body>
</html>
