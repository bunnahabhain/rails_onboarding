<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }
      .header {
        text-align: center;
        padding: 20px 0;
        border-bottom: 2px solid #f0f0f0;
      }
      .content {
        padding: 30px 0;
      }
      .cta-button {
        display: inline-block;
        padding: 12px 24px;
        background-color: #4F46E5;
        color: white;
        text-decoration: none;
        border-radius: 6px;
        margin: 20px 0;
      }
      .footer {
        text-align: center;
        padding: 20px 0;
        border-top: 2px solid #f0f0f0;
        color: #666;
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <div class="header">
      <h1>🎉 <%= t('rails_onboarding.mailer.welcome.heading', default: 'Welcome!') %></h1>
    </div>

    <div class="content">
      <p><%= t('rails_onboarding.mailer.welcome.greeting', default: 'Hi there!', name: @user.respond_to?(:name) ? @user.name : 'there') %></p>

      <p>
        <%= t('rails_onboarding.mailer.welcome.intro',
          default: "We're excited to have you on board! We've prepared a quick onboarding process to help you get started and make the most of your experience.") %>
      </p>

      <p>
        <%= t('rails_onboarding.mailer.welcome.description',
          default: "The onboarding process will guide you through the essential features and help you set up your account. It only takes a few minutes!") %>
      </p>

      <div style="text-align: center;">
        <a href="<%= @onboarding_url %>" class="cta-button">
          <%= t('rails_onboarding.mailer.welcome.cta', default: 'Get Started') %>
        </a>
      </div>

      <p>
        <%= t('rails_onboarding.mailer.welcome.help',
          default: "If you have any questions or need assistance, don't hesitate to reach out. We're here to help!") %>
      </p>
    </div>

    <div class="footer">
      <p><%= t('rails_onboarding.mailer.welcome.footer', default: 'Thank you for joining us!') %></p>
    </div>
  </body>
</html>
