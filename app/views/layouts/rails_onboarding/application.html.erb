<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <%# Without this, mobile Safari renders at a virtual ~980px desktop-width
      viewport and zooms out to fit the physical screen - everything (text,
      buttons, spacing) looks shrunk even though the CSS itself is correct. %>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= Rails.application.class.module_parent.name %> Onboarding</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <%= stylesheet_link_tag "rails_onboarding/application", media: "screen" %>
  <% if defined?(Propshaft) %>
    <%# Propshaft doesn't process application.css's Sprockets `require`
        directives, so each stylesheet needs its own tag or it silently
        never loads (tooltips, tour, milestones, mobile, etc). %>
    <%= stylesheet_link_tag "rails_onboarding/tooltips", media: "screen" %>
    <%= stylesheet_link_tag "rails_onboarding/utilities", media: "screen" %>
    <%= stylesheet_link_tag "rails_onboarding/accessibility", media: "screen" %>
    <%= stylesheet_link_tag "rails_onboarding/milestones", media: "screen" %>
    <%= stylesheet_link_tag "rails_onboarding/tour", media: "screen" %>
    <%= stylesheet_link_tag "rails_onboarding/flash_messages", media: "screen" %>
    <%= stylesheet_link_tag "rails_onboarding/progressive_disclosure", media: "screen" %>
    <%= stylesheet_link_tag "rails_onboarding/mobile", media: "screen" %>
  <% end %>

  <% if RailsOnboarding.configuration.include_host_styles %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload", media: "screen" %>
  <% end %>

  <%= javascript_include_tag "rails_onboarding/application", "data-turbo-track": "reload", defer: true %>
</head>
<body>

<%# .onboarding-container/.onboarding-content provide the page-level
    min-height/centering/responsive padding that the stylesheets (see
    application.css and mobile.css) already define for every onboarding
    page - without this wrapper, yielded content rendered directly under
    <body> with zero horizontal padding, which is invisible on wide
    viewports (there's empty space outside the content's own max-width
    either way) but runs text edge-to-edge on mobile. %>
<div class="onboarding-container">
  <div class="onboarding-content">
    <%= yield %>
  </div>
</div>

</body>
</html>
